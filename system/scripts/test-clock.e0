bootYear = clock.bootDatetime.year;
bootMonth = clock.bootDatetime.month;
bootDay = clock.bootDatetime.day;
currentYear = clock.currentDatetime.year;
currentMonth = clock.currentDatetime.month;
currentDay = clock.currentDatetime.day;
uptime = clock.uptimeMs;

if (bootYear >= 2020) {
    if (bootMonth >= 1) {
        if (bootDay >= 1) {
            if (currentYear >= bootYear) {
                if (currentMonth >= 1) {
                    if (currentDay >= 1) {
                        if (uptime >= 0) {
                            return 42;
                        }
                    }
                }
            }
        }
    }
}

return 0;
